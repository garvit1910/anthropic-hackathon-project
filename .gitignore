# Dependencies
node_modules/
.venv/
.tmp/
__pycache__/

# Env / secrets
.env
.env.*
!.env.example

# Build output
dist/
build/
.next/
.vercel/

# Raw datasets (downloaded inputs, not source)
zenodo_aneux/
aneurisk/
*.nii
*.nii.gz

# Real pipeline outputs (large binaries) — keep the folder, ignore its contents.
# The mock handoff (artifacts_mock/) IS committed; it's the contract spec.
/artifacts/case_*/
!/artifacts/.gitkeep

# OS / editor
.DS_Store
.claude/settings.local.json

# CMHA dataset (Song et al. 2024, figshare 26965450) — git-ignored like other datasets
cmha/

# Lausanne TOF-MRA scans (OpenNeuro ds003949) — git-ignored
lausanne/
public/
